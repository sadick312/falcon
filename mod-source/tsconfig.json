{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "es2025",
        // esbuild bundles this workspace, so resolve imports the way a bundler does.
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        // Reading list[i] or record[key] gives "maybe undefined", so a missing entry has to be handled.
        "noUncheckedIndexedAccess": true,
        "paths": {
            "@combat-modules/*": [
                "./src/core/mod/combat/modules/*"
            ],
            "@combat-utils/*": [
                "./src/core/mod/combat/utils/*"
            ],
            "@simulation/*": [
                "./src/core/mod/simulation/*"
            ],
            "@placing/*": [
                "./src/core/mod/combat/placing/*"
            ],
            "@menu/*": [
                "./src/core/menu/*"
            ],
            "@core/*": [
                "./src/core/*"
            ],
            "@utils/*": [
                "./src/utils/utils/*"
            ],
            "@mod-types/*": [
                "./src/utils/types/*"
            ],
            "@constants/*": [
                "./src/utils/constants/*"
            ],
            "@entities/*": [
                "./src/constants/*"
            ],
            "@ui/*": [
                "./src/ui/*"
            ],
            "@rendering/*": [
                "./src/rendering/*"
            ],
            "@services/*": [
                "./src/services/*"
            ],
            "@root/*": [
                "./src/*"
            ]
        },
        "types": [
            "cloudflare-turnstile",
            "./src/types"
        ]
    },
    "include": [
        "src"
    ]
}
