{
    "manifest_version": 3,
    "name": "Falcon Launcher",
    "description": "Loads the Falcon client on sandbox.moomodding.io (bundled, MooMoo 1.8.2) and sandbox.moomoo.io (local backend).",
    "version": "1.1.0",
    "action": {},
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "permissions": [
        "storage",
        "webNavigation",
        "scripting",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://sandbox.moomoo.io/*",
        "http://localhost:8080/*",
        "*://sandbox.moomodding.io/*"
    ],
    "content_scripts": [
        {
            "js": [
                "src/remove.js"
            ],
            "matches": [
                "*://sandbox.moomoo.io/*"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ]
}
