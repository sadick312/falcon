{
    "name": "moomoo-falcon-platform",
    "version": "1.0.0",
    "description": "this might be the worse idea in the world",
    "license": "SEE LICENSE in LICENSE",
    "author": "falcon developers",
    "type": "commonjs",
    "workspaces": [
        "mod-source",
        "falcon-launcher"
    ],
    "scripts": {
        "install:all": "npm install && npm install --prefix tools/lint",
        "build": "npm run inject:build && npm run ext:build",
        "build:all": "npm run build",
        "dev": "node scripts/dev.mjs",
        "mod:build": "npm run build --workspace=mod-source",
        "mod:build:dev": "npm run build:dev --workspace=mod-source",
        "mod:watch": "npm run watch --workspace=mod-source",
        "inject:build": "npm run build --workspace=mod-source && npm run build:inject --workspace=mod-source",
        "ext:build": "npm run build --workspace=falcon-launcher",
        "ext:dev": "npm run dev --workspace=falcon-launcher",
        "typecheck": "npm run typecheck --workspace=mod-source && npm exec --workspace=falcon-launcher -- tsc --noEmit && node scripts/check-indexed-access.mjs",
        "lint": "node scripts/tool.mjs eslint -c tools/lint/eslint.config.mjs .",
        "lint:fix": "node scripts/tool.mjs eslint -c tools/lint/eslint.config.mjs . --fix",
        "format": "node scripts/tool.mjs prettier --write .",
        "format:check": "node scripts/tool.mjs prettier --check .",
        "docs:settings": "node scripts/gen-settings-doc.mjs",
        "test": "vitest run",
        "test:smoke": "node scripts/smoke-test.mjs",
        "bench": "vitest run --config vitest.bench.config.mts",
        "stats": "node scripts/dev-stats.mjs",
        "stats:report": "node scripts/lib/report.mjs",
        "postinstall": "npm ci --prefix tools/lint --no-workspaces --no-audit --no-fund",
        "typecheck:indexed": "node scripts/check-indexed-access.mjs",
        "check:dead": "npm run mod:build && node scripts/check-dead.mjs"
    },
    "allowScripts": {
        "esbuild@0.27.7": true,
        "fsevents@2.3.3": true
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^5.0.5",
        "fast-check": "4.10.2",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
